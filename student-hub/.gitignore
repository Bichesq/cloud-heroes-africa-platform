# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env files
.env.local

# copied by ../scripts/sync-shared-prisma.mjs — edit prisma-shared/*.prisma
# instead (docs/plan/2026-08-23-centralize-shared-data.md)
/prisma/schema/platform-core-models.prisma
/prisma/schema/student-hub-local-models.prisma

# data files
data/approved-emails.json
data/students.json
data/audit-log.json
data/progress.json
data/todos.json

# user-uploaded avatars
/public/uploads/
