// ============================================================================
// 2026-09-24 (plan 2026-09-21-learning-management-authoring-app, sub-step 1):
// moved verbatim from learning-platform/prisma/schema/lp-core.prisma into
// prisma-shared/ so learning-management gets real relational access to the
// Lp* models. Copied into every app's prisma/schema/ by
// scripts/sync-shared-prisma.mjs — edit THIS file, never the copies.
// learning-platform remains the sole `prisma migrate` runner; its
// generator/datasource blocks now live in learning-platform/prisma/schema/
// schema.prisma (multi-file schema allows them in exactly one file).
// The original file header follows unchanged.
// ============================================================================

// ============================================================================
// Learning Platform — Prisma schema (v2)
// Generated from docs/learning-platform/schema.sql §3 in
// prompts/learning_platform/learning-platform-backend-migration-brief.md.
// Phase 1 of the migration plan (see .claude/plans — "Learning Platform
// Backend Migration").
//
// This file now holds ONLY the Lp*-prefixed models (content/progress/
// assessment domain) plus the datasource/generator blocks — the sole
// migration-runner file for this multi-file schema (prisma/schema/). The 4
// shared platform-core models (ApprovedEmail, Student, SupportTicket,
// AuditEntry) and the 4 student-hub-local models (Todo, Event,
// ShMockProgram, ShUnitCompletion) live in sibling files copied in from
// prisma-shared/ by scripts/sync-shared-prisma.mjs — see
// docs/plan/2026-08-23-centralize-shared-data.md.
//
// Every `studentId` column below is now backed by a REAL Postgres foreign
// key to `students(id)`, added by the hand-authored migration
// `add_student_fk` (applied only after scripts/migrate-shared-data.ts
// populated the `students` table — adding it earlier would have failed
// against existing rows referencing student ids not yet present anywhere).
//
// That FK is intentionally NOT modeled as a Prisma `@relation` field here.
// Prisma requires both sides of a relation (a back-relation array field on
// `Student`) to be declared in the SAME generated Prisma Client — but
// `Student` is copied verbatim into student-hub's independently-generated
// client too (see prisma-shared/platform-core-models.prisma), which has no
// Lp*-prefixed models to reference. Adding LP-only back-relation fields to
// the shared Student model would break `prisma generate` in student-hub.
// So: the FK exists and is enforced at the database level (closing the gap
// the original header note below flagged), but `studentId` stays a plain
// scalar column here — no `.student`/`.include({ student: true })`
// convenience on these 9 models. A future `prisma migrate dev` run WILL
// show this FK as drift (schema says "no relation", DB has one) — do NOT
// accept a proposal to drop it; that anti-drift tradeoff is deliberate.
//
// Deviations from the brief's literal raw SQL, made necessary by Prisma's
// declarative model (all flagged for review):
//
// 1. `id uuid PRIMARY KEY DEFAULT gen_random_uuid()` — modeled as
//    `@default(uuid())` (Prisma-generated, client-side) instead of
//    `dbgenerated("gen_random_uuid()")`, so no Postgres extension
//    (pgcrypto) or PG16+ requirement is needed. Functionally equivalent —
//    ids are still random UUIDs — just generated by the app instead of
//    the database.
// 2. `CHECK (type IN (...))` / other enumerated CHECK constraints are
//    modeled as native Prisma enums (Postgres enum types) rather than
//    CHECK constraints. Stricter, not weaker.
// 3. `CHECK (num_nonnulls(module_id, program_id) = 1)` on
//    lp_standalone_assessments has NO Prisma equivalent. Enforce it either
//    with a hand-added SQL migration step after `prisma migrate dev`
//    (`ALTER TABLE lp_standalone_assessments ADD CONSTRAINT
//    chk_standalone_scope CHECK (num_nonnulls(module_id, program_id) = 1);`)
//    or at the application layer in lib/store — not yet done either way.
// ============================================================================

// ------------------------------------------------------------------
// Content hierarchy: Program → Module → Unit → ContentBlock. Exactly
// three navigational levels (2026-08-11, final). Authored in Learning
// Management; LP only reads published content.
// ------------------------------------------------------------------

model LpProgram {
  id        String   @id
  title     String
  slug      String   @unique
  blurb     String   @default("")
  heroImage String?  @map("hero_image")
  language  String   @default("en")
  delivery  String   @default("self-paced")
  creators  Json     @default("[]")
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  /// 2026-09-24 (Phase 4): the single, fixed Creator (2026-07-06 decision).
  /// `creators` JSON stays for existing data until backfilled.
  creatorAuthorId String? @map("creator_author_id") @db.Uuid
  /// 2026-09-28 (Phase 4 sub-step 2): Program Setup thumbnail — an opaque
  /// key into learning-management's media storage (plan decision #5), served
  /// only through its authenticated route. `heroImage` (public URL used by
  /// the learner catalogue) is deliberately separate.
  thumbnailKey    String?  @map("thumbnail_key")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  modules               LpModule[]
  enrollments           LpEnrollment[]
  readinessAssessments  LpReadinessAssessment[]
  standaloneAssessments LpStandaloneAssessment[] @relation("ProgramStandaloneAssessments")
  creatorAuthor         LpAuthor?                @relation("ProgramCreator", fields: [creatorAuthorId], references: [id], onDelete: SetNull)
  contributors          LpProgramContributor[]
  instructors           LpProgramInstructor[]
  directors             LpProgramDirector[]
  owners                LpProgramOwner[]
  auditEntries          LpAuthoringAuditEntry[]

  @@map("lp_programs")
}

model LpModule {
  id          String @id
  programId   String @map("program_id")
  title       String
  order       Int
  description String @default("")

  program               LpProgram                @relation(fields: [programId], references: [id], onDelete: Cascade)
  units                 LpUnit[]
  standaloneAssessments LpStandaloneAssessment[] @relation("ModuleStandaloneAssessments")

  @@map("lp_modules")
}

/// Unit is the only level between Module and content. Carries the
/// unlock-gating tokens, is what a Knowledge Check tests, and is a plain
/// content container otherwise — no `type`, no children besides its own
/// ContentBlocks. (2026-08-11: merges the original lp_units + lp_items;
/// lp_sections is eliminated entirely.)
model LpUnit {
  id             String  @id
  moduleId       String  @map("module_id")
  title          String
  order          Int
  description    String  @default("")
  durationMin    Int     @default(0) @map("duration_min")
  heroImage      String? @map("hero_image")
  tokensAward    Int     @default(0) @map("tokens_award")
  tokensRequired Int     @default(0) @map("tokens_required")
  creators       Json    @default("[]")
  /// 2026-09-24 (Phase 4, Q9): per-unit Creator ("owns and maintains this
  /// unit's content"). `creators` JSON stays until backfilled.
  creatorAuthorId String? @map("creator_author_id") @db.Uuid

  module          LpModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  knowledgeChecks LpKnowledgeCheck[]
  contentBlocks   LpContentBlock[]
  studentUnits    LpStudentUnit[]
  goals           LpUnitGoal[]
  notes           LpNote[]
  topics          LpTopic[]
  studentTopics   LpStudentTopic[]
  creatorAuthor   LpAuthor?          @relation("UnitCreator", fields: [creatorAuthorId], references: [id], onDelete: SetNull)

  @@map("lp_units")
}

/// A Knowledge Check tests a Unit as a whole. The unit "having" one is
/// expressed by this table referencing it, not by a type field on the unit.
/// 2026-09-21 (plan Phase 3 step 1): the old fixed inline `questions` JSON
/// blob is replaced by a question bank (`LpKcQuestionBankItem`) +
/// per-attempt randomized selection, mirroring how Standalone Assessments
/// already work — no data migration needed, the dev DB had zero seeded rows.
model LpKnowledgeCheck {
  id                  String  @id
  unitId              String  @map("unit_id")
  title               String
  passThreshold       Decimal @default(0.7) @map("pass_threshold")
  /// How many bank questions are randomly drawn per attempt (brief: "10-15
  /// authored -> N shown"). No difficulty-mix weighting for KCs, unlike
  /// Standalone Assessments — not asked for, selection is uniform random.
  questionsPerAttempt Int     @default(10) @map("questions_per_attempt")

  unit         LpUnit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questionBank LpKcQuestionBankItem[]
  attempts     LpKcAttempt[]

  @@map("lp_knowledge_checks")
}

/// KC question bank item. Deliberately narrower than LpQuestionBankItem: no
/// `type` (KCs stay single_choice-only for V1, per the "Already built"
/// scope note in the plan doc — multi_select/Code aren't requested here) and
/// no `topicId` (nothing in the KC UX consumes a weak-topic rollup the way
/// Standalone Assessments do, so it isn't mirrored just for shape parity).
model LpKcQuestionBankItem {
  id              String             @id @default(uuid()) @db.Uuid
  kcId            String             @map("kc_id")
  difficulty      QuestionDifficulty @default(medium)
  prompt          String
  options         Json
  correctOptionId String             @map("correct_option_id")
  explanation     String?

  knowledgeCheck   LpKnowledgeCheck      @relation(fields: [kcId], references: [id], onDelete: Cascade)
  attemptQuestions LpKcAttemptQuestion[]

  @@map("lp_kc_question_bank_items")
}

enum ContentBlockType {
  heading
  richtext
  image
  code
  callout
  video

  @@map("lp_content_block_type")
}

/// Ordered content blocks inside a Unit's body. Video lives here
/// (type=video), not as a separate unit-level type — payload is JSON so a
/// future block type needs no migration.
model LpContentBlock {
  id      String           @id
  unitId  String           @map("unit_id")
  order   Int
  type    ContentBlockType
  payload Json
  /// 2026-09-23: optional Topic this block belongs to. Null = the unit has
  /// no Topic breakdown and renders as one flat reading (pre-Topic data).
  topicId String?          @map("topic_id") @db.Uuid

  unit  LpUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topic LpTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@map("lp_content_blocks")
}

// ------------------------------------------------------------------
// Enrollment — thin, LP-owned until an Administration surface exists.
// ------------------------------------------------------------------

enum EnrollmentStatus {
  active
  completed

  @@map("lp_enrollment_status")
}

model LpEnrollment {
  studentId  String           @map("student_id") @db.Uuid
  programId  String           @map("program_id")
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  status     EnrollmentStatus @default(active)

  program LpProgram @relation(fields: [programId], references: [id])

  @@id([studentId, programId])
  @@map("lp_enrollments")
}

// ------------------------------------------------------------------
// Student progress
// ------------------------------------------------------------------

enum StudentUnitStatus {
  in_progress
  completed
  retake
  verified

  @@map("lp_student_unit_status")
}

/// Dual-state model (2026-05-21): Completed (content finished) vs
/// Competent/Verified (knowledge check passed), each with its own
/// timestamp. 'retake' is the post-KC-failure state. (2026-08-11: with
/// Section/Item removed, this is the single progress table again — see
/// plan Ambiguity #2 for what now decides "content finished" without a
/// leaf level below Unit.)
model LpStudentUnit {
  studentId   String            @map("student_id") @db.Uuid
  unitId      String            @map("unit_id")
  status      StudentUnitStatus
  completedAt DateTime?         @map("completed_at")
  verifiedAt  DateTime?         @map("verified_at")
  updatedAt   DateTime          @default(now()) @map("updated_at")

  unit LpUnit @relation(fields: [unitId], references: [id])

  @@id([studentId, unitId])
  @@map("lp_student_units")
}

/// 2026-09-21 (plan Phase 3): now created at attempt *start* (status
/// in_progress, score/passed null) so the randomly-selected question set can
/// be snapshotted (LpKcAttemptQuestion) before the learner answers, the same
/// way LpAttemptQuestion pins a Standalone Assessment attempt's questions.
/// This closes a real integrity gap the old submit-only design would have
/// had once questions came from a bank: without a server-pinned snapshot, a
/// client could submit an arbitrary subset of "which questions count",
/// skewing its own score. No save-and-resume of in-progress answers is
/// implemented (not requested for KCs, unlike Standalone Assessments) — an
/// abandoned in_progress attempt is just reused (same selection returned) on
/// the next start call rather than spawning a duplicate.
model LpKcAttempt {
  id          String        @id @default(uuid()) @db.Uuid
  studentId   String        @map("student_id") @db.Uuid
  kcId        String        @map("kc_id")
  attemptNo   Int           @map("attempt_no")
  status      AttemptStatus @default(in_progress)
  /// questionBankItemId(attemptQuestionId) -> chosen optionId, null =
  /// skipped. Written once, at submit.
  answers     Json?
  score       Decimal?
  passed      Boolean?
  createdAt   DateTime      @default(now()) @map("created_at")
  submittedAt DateTime?     @map("submitted_at")

  knowledgeCheck LpKnowledgeCheck      @relation(fields: [kcId], references: [id])
  questions      LpKcAttemptQuestion[]

  @@index([studentId, kcId, createdAt], map: "lp_kc_attempts_student_kc")
  @@map("lp_kc_attempts")
}

/// Snapshot of which bank items were randomly selected for a specific KC
/// attempt — mirrors LpAttemptQuestion's role for Standalone Assessments.
model LpKcAttemptQuestion {
  id                   String @id @default(uuid()) @db.Uuid
  attemptId            String @map("attempt_id") @db.Uuid
  kcQuestionBankItemId String @map("kc_question_bank_item_id") @db.Uuid
  orderIndex           Int    @map("order_index")

  attempt          LpKcAttempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionBankItem LpKcQuestionBankItem @relation(fields: [kcQuestionBankItemId], references: [id])

  @@unique([attemptId, kcQuestionBankItemId])
  @@map("lp_kc_attempt_questions")
}

enum TokenSourceType {
  unit_completion
  kc_pass
  assessment
  adjustment

  @@map("lp_token_source_type")
}

/// Append-only ledger. balance = SUM(tokens). Idempotent awards via the
/// unique constraint. (2026-08-11: renamed from lp_points_ledger, §1.)
model LpTokenLedger {
  id         String          @id @default(uuid()) @db.Uuid
  studentId  String          @map("student_id") @db.Uuid
  sourceType TokenSourceType @map("source_type")
  sourceId   String          @map("source_id")
  tokens     Int
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([studentId, sourceType, sourceId])
  @@map("lp_token_ledger")
}

/// Goals Meeting Streak deadlines.
model LpUnitGoal {
  studentId  String   @map("student_id") @db.Uuid
  unitId     String   @map("unit_id")
  targetDate DateTime @map("target_date") @db.Date
  setAt      DateTime @default(now()) @map("set_at")

  unit LpUnit @relation(fields: [unitId], references: [id])

  @@id([studentId, unitId])
  @@map("lp_unit_goals")
}

/// One free-text note per (student, unit).
model LpNote {
  studentId String   @map("student_id") @db.Uuid
  unitId    String   @map("unit_id")
  body      String   @default("")
  updatedAt DateTime @default(now()) @map("updated_at")

  unit LpUnit @relation(fields: [unitId], references: [id])

  @@id([studentId, unitId])
  @@map("lp_notes")
}

// ------------------------------------------------------------------
// Exam Readiness — UNCHANGED shape from the existing schema, kept
// deliberately simple (fixed question set, no randomization/time-box).
// ASSUMPTION: the Aug 6 assessment-engine rules (question banks,
// randomization, cooldowns, time limits) apply to standalone Assessments
// only, not Readiness. Flag if this is wrong.
// ------------------------------------------------------------------

model LpReadinessAssessment {
  id          String @id
  programId   String @map("program_id")
  title       String
  description String @default("")
  /// {questions: [...], levels: [{min, label}]}
  config      Json   @default("{}")

  program LpProgram           @relation(fields: [programId], references: [id])
  results LpReadinessResult[]

  @@map("lp_readiness_assessments")
}

model LpReadinessResult {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  assessmentId String   @map("assessment_id")
  score        Decimal
  level        String?
  detail       Json?
  submittedAt  DateTime @default(now()) @map("submitted_at")

  assessment LpReadinessAssessment @relation(fields: [assessmentId], references: [id])

  @@index([studentId, assessmentId, submittedAt], map: "lp_readiness_results_student")
  @@map("lp_readiness_results")
}

// ------------------------------------------------------------------
// Standalone Assessments — FULL REBUILD per Aug 6 decisions. The old
// lp_assessments/lp_assessment_results (fixed question list, no bank, no
// randomization, no time-box, no cooldowns) is replaced entirely for this
// assessment kind. Practical/file-upload submissions are DROPPED from V1
// per 2026-08-11 decision.
// ------------------------------------------------------------------

/// A Topic is both the assessment weak-topic tag on question-bank items and
/// (2026-09-23, Sept 21 Unit → Topic decision) a navigable sub-page of a
/// Unit. `order` null = tag-only topic, not shown in unit navigation.
model LpTopic {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  unitId      String? @map("unit_id")
  order       Int?
  description String  @default("")

  unit              LpUnit?              @relation(fields: [unitId], references: [id])
  questionBankItems LpQuestionBankItem[]
  contentBlocks     LpContentBlock[]
  studentTopics     LpStudentTopic[]

  @@index([unitId, order])
  @@map("lp_topics")
}

/// 2026-09-24 (plan 2026-09-24-per-topic-unit-progress): one row per topic a
/// student has completed (pressed Next on). Drives per-topic ticks and the
/// unit progress bar; a unit's reading is complete once every navigable
/// topic has a row. `student_id` → students(id) is a hand-authored DB-only
/// FK like the others (see 20260826014535_add_student_fk).
model LpStudentTopic {
  studentId   String   @map("student_id") @db.Uuid
  topicId     String   @map("topic_id") @db.Uuid
  unitId      String   @map("unit_id")
  completedAt DateTime @default(now()) @map("completed_at")

  topic LpTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  unit  LpUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([studentId, topicId])
  @@index([studentId, unitId])
  @@map("lp_student_topics")
}

model LpStandaloneAssessment {
  id                  String  @id
  moduleId            String? @map("module_id")
  programId           String? @map("program_id")
  title               String
  description         String  @default("")
  questionsPerAttempt Int     @map("questions_per_attempt")
  difficultyMix       Json    @default("{}") @map("difficulty_mix")
  passThreshold       Decimal @default(0.75) @map("pass_threshold")
  timeLimitSeconds    Int     @map("time_limit_seconds")

  module            LpModule?             @relation("ModuleStandaloneAssessments", fields: [moduleId], references: [id])
  program           LpProgram?            @relation("ProgramStandaloneAssessments", fields: [programId], references: [id])
  questionBankItems LpQuestionBankItem[]
  attempts          LpAssessmentAttempt[]

  // See file-header note 4 — num_nonnulls(module_id, program_id) = 1 is not
  // enforced here yet.
  @@map("lp_standalone_assessments")
}

enum QuestionType {
  single_choice
  multi_select

  @@map("lp_question_type")
}

enum QuestionDifficulty {
  easy
  medium
  difficult

  @@map("lp_question_difficulty")
}

model LpQuestionBankItem {
  id               String             @id @default(uuid()) @db.Uuid
  assessmentId     String             @map("assessment_id")
  topicId          String?            @map("topic_id") @db.Uuid
  type             QuestionType
  difficulty       QuestionDifficulty
  prompt           String
  options          Json
  correctOptionIds Json               @map("correct_option_ids")
  pointsPossible   Decimal            @default(1) @map("points_possible")
  explanation      String?

  assessment       LpStandaloneAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  topic            LpTopic?               @relation(fields: [topicId], references: [id])
  attemptQuestions LpAttemptQuestion[]
  reports          LpQuestionReport[]

  @@map("lp_question_bank_items")
}

enum AttemptStatus {
  in_progress
  submitted
  expired

  @@map("lp_attempt_status")
}

model LpAssessmentAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  assessmentId   String        @map("assessment_id")
  studentId      String        @map("student_id") @db.Uuid
  attemptNumber  Int           @map("attempt_number")
  status         AttemptStatus @default(in_progress)
  score          Decimal?
  passed         Boolean?
  startedAt      DateTime      @default(now()) @map("started_at")
  lastSavedAt    DateTime?     @map("last_saved_at")
  submittedAt    DateTime?     @map("submitted_at")
  nextEligibleAt DateTime?     @map("next_eligible_at")
  /// [{topic_id, topic_name, unit_id, score_pct}]
  weakTopics     Json?         @map("weak_topics")

  assessment LpStandaloneAssessment @relation(fields: [assessmentId], references: [id])
  questions  LpAttemptQuestion[]
  reports    LpQuestionReport[]

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([studentId, assessmentId, attemptNumber], map: "lp_assessment_attempts_student")
  @@map("lp_assessment_attempts")
}

/// Snapshot of which questions were randomly selected for a specific
/// attempt — preserves exact historical record even as retakes re-randomize.
model LpAttemptQuestion {
  id                 String @id @default(uuid()) @db.Uuid
  attemptId          String @map("attempt_id") @db.Uuid
  questionBankItemId String @map("question_bank_item_id") @db.Uuid
  orderIndex         Int    @map("order_index")

  attempt          LpAssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionBankItem LpQuestionBankItem  @relation(fields: [questionBankItemId], references: [id])
  answer           LpAttemptAnswer?

  @@unique([attemptId, questionBankItemId])
  @@map("lp_attempt_questions")
}

/// 1:1 with LpAttemptQuestion; written progressively (upsert) to support
/// save-and-resume. pointsEarned is numeric to encode multi-select partial
/// credit; both selectedOptionIds and pointsEarned stay hidden from the
/// client until submission ("no correctness during attempt"). `flagged` is
/// the learner's "Flag for Review" toggle (brief §5.2) — independent of and
/// persisted the same way as the answer itself, so it survives save/resume.
model LpAttemptAnswer {
  attemptQuestionId String   @id @map("attempt_question_id") @db.Uuid
  selectedOptionIds Json     @default("[]") @map("selected_option_ids")
  pointsEarned      Decimal? @map("points_earned")
  flagged           Boolean  @default(false)
  answeredAt        DateTime @default(now()) @map("answered_at")

  attemptQuestion LpAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  @@map("lp_attempt_answers")
}

/// Question-issue reports (brief §5.5) — a learner-flagged problem with a
/// specific question (wrong answer key, unclear prompt, etc.), collected on
/// the end-of-flow reporting screen and routed to admins/support. Kept as
/// its own table rather than reusing SupportTicket: this is
/// learning-platform-owned assessment-content data, not a Help Desk ticket
/// (docs/plan/2026-09-20-learning-platform-v1-build.md, Phase 1 step 6).
model LpQuestionReport {
  id                 String   @id @default(uuid()) @db.Uuid
  attemptId          String   @map("attempt_id") @db.Uuid
  questionBankItemId String   @map("question_bank_item_id") @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  detail             String
  createdAt          DateTime @default(now()) @map("created_at")

  attempt          LpAssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionBankItem LpQuestionBankItem  @relation(fields: [questionBankItemId], references: [id])

  @@index([questionBankItemId])
  @@map("lp_question_reports")
}

// ------------------------------------------------------------------
// Escalations — extended to cover repeated Assessment failure, not just
// KC second failure. (2026-08-11.)
// ------------------------------------------------------------------

enum EscalationKind {
  kc_second_failure
  assessment_repeated_failure

  @@map("lp_escalation_kind")
}

model LpEscalation {
  id           String         @id @default(uuid()) @db.Uuid
  studentId    String         @map("student_id") @db.Uuid
  kind         EscalationKind
  refId        String         @map("ref_id")
  payload      Json           @default("{}")
  acknowledged Boolean        @default(false)
  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("lp_escalations")
}

// ------------------------------------------------------------------
// Authoring identity + program-scoped roles (2026-09-24, Phase 4 sub-step 1;
// plan docs/plan/2026-09-21-learning-management-authoring-app.md §2).
// Written by learning-management (Microsoft SSO), read by learning-platform
// only for display. An author is internal CHA staff — deliberately NOT a
// Student row or a role flag on Student (a person can be both).
// Every role below is scoped to ONE program (requirements §6.5: independent
// of any global platform role); there is no platform-wide author role
// (2026-09-24 decision: per-program visibility).
// ------------------------------------------------------------------

model LpAuthor {
  id        String   @id @default(uuid()) @db.Uuid
  /// Lower-cased Microsoft sign-in email.
  email     String   @unique
  name      String   @default("")
  /// Entra ID object id (`oid` claim) — the stable identity if an email
  /// ever changes; set on first sign-in.
  entraOid  String?  @unique @map("entra_oid")
  createdAt DateTime @default(now()) @map("created_at")

  createdPrograms   LpProgram[]            @relation("ProgramCreator")
  createdUnits      LpUnit[]               @relation("UnitCreator")
  contributorRoles  LpProgramContributor[] @relation("ContributorAuthor")
  instructorRoles   LpProgramInstructor[]  @relation("InstructorAuthor")
  directorRoles     LpProgramDirector[]    @relation("DirectorAuthor")
  ownerRoles        LpProgramOwner[]       @relation("OwnerAuthor")
  addedContributors LpProgramContributor[] @relation("ContributorAddedBy")
  addedInstructors  LpProgramInstructor[]  @relation("InstructorAddedBy")
  addedDirectors    LpProgramDirector[]    @relation("DirectorAddedBy")
  addedOwners       LpProgramOwner[]       @relation("OwnerAddedBy")
  auditActions      LpAuthoringAuditEntry[] @relation("AuditActor")
  auditSubjects     LpAuthoringAuditEntry[] @relation("AuditSubject")

  @@map("lp_authors")
}

/// Settings & Access authoring roles (§6.5).
enum LpContributorRole {
  editor
  reviewer
  viewer

  @@map("lp_contributor_role")
}

/// Contributors table (§6.5): one row per person per program.
model LpProgramContributor {
  programId String            @map("program_id")
  authorId  String            @map("author_id") @db.Uuid
  role      LpContributorRole
  addedAt   DateTime          @default(now()) @map("added_at")
  /// Null for bootstrap/backfill rows.
  addedById String?           @map("added_by_id") @db.Uuid

  program LpProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  author  LpAuthor  @relation("ContributorAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  addedBy LpAuthor? @relation("ContributorAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([programId, authorId])
  @@index([authorId])
  @@map("lp_program_contributors")
}

/// Program Instructors (§6.1) — a list that can change without changing
/// the Creator; not an authoring permission.
model LpProgramInstructor {
  programId String   @map("program_id")
  authorId  String   @map("author_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at")
  addedById String?  @map("added_by_id") @db.Uuid

  program LpProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  author  LpAuthor  @relation("InstructorAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  addedBy LpAuthor? @relation("InstructorAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([programId, authorId])
  @@index([authorId])
  @@map("lp_program_instructors")
}

/// Program Directors — an add/remove list, not a single field (2026-09-17).
model LpProgramDirector {
  programId String   @map("program_id")
  authorId  String   @map("author_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at")
  addedById String?  @map("added_by_id") @db.Uuid

  program LpProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  author  LpAuthor  @relation("DirectorAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  addedBy LpAuthor? @relation("DirectorAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([programId, authorId])
  @@index([authorId])
  @@map("lp_program_directors")
}

/// Program Owners — an add/remove list, not a single field (2026-09-17).
model LpProgramOwner {
  programId String   @map("program_id")
  authorId  String   @map("author_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at")
  addedById String?  @map("added_by_id") @db.Uuid

  program LpProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  author  LpAuthor  @relation("OwnerAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  addedBy LpAuthor? @relation("OwnerAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([programId, authorId])
  @@index([authorId])
  @@map("lp_program_owners")
}

/// Learning Management audit trail actions (decision-log open item 23;
/// plan 2026-09-21 §7).
enum LpAuthoringAuditAction {
  program_created
  program_updated
  creator_changed
  thumbnail_changed
  instructor_added
  instructor_removed
  contributor_added
  contributor_removed
  contributor_role_changed
  director_added
  director_removed
  owner_added
  owner_removed

  @@map("lp_authoring_audit_action")
}

/// Append-only: written in the same transaction as the change it records,
/// never updated or deleted by application code.
model LpAuthoringAuditEntry {
  id              String                 @id @default(uuid()) @db.Uuid
  programId       String                 @map("program_id")
  actorAuthorId   String                 @map("actor_author_id") @db.Uuid
  action          LpAuthoringAuditAction
  /// The person granted/removed/re-roled, when the action is about one.
  subjectAuthorId String?                @map("subject_author_id") @db.Uuid
  /// { before, after } for field changes; role names for role changes.
  details         Json                   @default("{}")
  createdAt       DateTime               @default(now()) @map("created_at")

  program LpProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  actor   LpAuthor  @relation("AuditActor", fields: [actorAuthorId], references: [id], onDelete: Restrict)
  subject LpAuthor? @relation("AuditSubject", fields: [subjectAuthorId], references: [id], onDelete: Restrict)

  @@index([programId, createdAt])
  @@map("lp_authoring_audit_log")
}
