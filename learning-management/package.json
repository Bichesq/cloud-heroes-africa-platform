{
  "name": "learning-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "test": "vitest run",
    "prisma:sync": "node ../scripts/sync-shared-prisma.mjs",
    "prisma:generate": "npm run prisma:sync && prisma generate",
    "prisma:migrate": "node -e \"console.error('learning-management never runs migrations: learning-platform is the sole migrate runner (docs/shared-schema-audit.md). Run npm run prisma:migrate in learning-platform/.'); process.exit(1)\"",
    "bootstrap:roles": "tsx scripts/bootstrap-program-roles.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@prisma/client": "^6",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2"
  }
}
