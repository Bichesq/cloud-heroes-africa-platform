# learning-management — copy to .env and fill in. Never commit .env.

# Same shared database as learning-platform / student-hub.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/learning_platform?schema=public"

# MUST be a NEW random value, different from the AUTH_SECRET shared by
# learning-platform and student-hub (plan 2026-09-21 Risks: staff sessions
# are a separate trust boundary). Generate with:  npx auth secret
AUTH_SECRET=""

# Microsoft Entra ID app registration for the CHA tenant.
# Redirect URI (dev): http://localhost:3002/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Directory (tenant) ID — sign-in is restricted to this tenant (decision #4).
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# Local dev only.
AUTH_URL="http://localhost:3002"

# DEVELOPMENT ONLY — email login without Microsoft (lib/dev-login.ts).
# Ignored unless NODE_ENV != production; the app refuses to START in
# production if LM_DEV_LOGIN is set at all. Comma-separated allowlist.
# LM_DEV_LOGIN=1
# LM_DEV_EMAILS="you@example.com"
